// Book Service ERD
// src/main/resources/db/migration의 V1~V5(Flyway) 적용 후 최종 스키마를 그대로 옮긴 것이다.
// 마이그레이션이 추가/변경되면 이 파일도 함께 갱신해야 한다(자동 동기화 없음).
// dbdiagram.io 등 DBML 렌더러에 붙여넣으면 다이어그램으로 볼 수 있다.

Table shelf {
  shelf_id bigint [pk, increment]
  member_id varchar(255) [not null, note: '외부 Member/Auth 서비스의 회원 식별자(Cognito sub) — 이 서비스가 소유하지 않음, FK 없음']
  name varchar(50) [not null]
  is_default boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (member_id) [unique, name: 'uk_shelf_member_default', note: 'WHERE is_default = true — 회원당 기본 책장 1개']
  }

  Note: '회원의 책장. is_default=true인 행은 회원가입 이벤트 없이 필요 시점에 서버가 get-or-create로 생성한다(ADR-0008). 삭제 불가.'
}

Table library_book {
  book_id bigint [pk, increment]
  member_id varchar(255) [not null, note: '외부 Member/Auth 서비스 회원 식별자 — FK 없음']
  shelf_id bigint [not null, ref: > shelf.shelf_id]
  shelf_rank varchar(128) [not null, note: 'LexoRank 불투명 문자열, COLLATE "C". 같은 shelf_id 안에서 진열 순서를 표현']
  title varchar(200) [not null]
  author varchar(100) [not null]
  isbn varchar(13)
  publisher varchar(100)
  published_date date
  cover_url varchar(2048)
  total_pages integer [not null]
  current_page integer [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (shelf_id, shelf_rank) [unique, name: 'uk_library_book_shelf_rank']
    (member_id, isbn) [unique, name: 'uk_library_book_member_isbn', note: 'WHERE isbn IS NOT NULL — ISBN 있는 도서만 회원별 중복 등록 금지(ADR-0007)']
  }

  Note: '회원이 서재에 등록한 책 한 권. aggregate root.'
}

Table scrap {
  scrap_id bigint [pk, increment]
  book_id bigint [not null, ref: > library_book.book_id, note: 'ON DELETE CASCADE — 책 삭제 시 스크랩도 함께 삭제']
  sentence varchar(2000) [not null]
  page_number integer
  memo varchar(2000)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (book_id) [name: 'ix_scrap_book_id']
  }

  Note: '책에 딸린 문장 스크랩. 독립된 member_id 없이 library_book을 통해서만 소유권이 정해진다.'
}

Table librarian {
  librarian_id bigint [pk, note: '자동 증가 아님 — Flyway seed에서 명시적으로 값 부여']
  name varchar(50) [not null]
  type varchar(30) [not null, note: 'CAT | BIRD']
  image_url varchar(500) [not null]
  evolution_stage integer [not null]

  Note: '동물 사서 마스터 데이터. 앱이 생성/수정하지 않고 Flyway 마이그레이션이 직접 INSERT한다.'
}

Table member_librarian_selection {
  id bigint [pk, increment]
  member_id varchar(255) [not null, note: '외부 Member/Auth 서비스 회원 식별자 — FK 없음']
  librarian_id bigint [not null, ref: > librarian.librarian_id]
  selected_at timestamptz [not null, default: `now()`, note: '최초 선택·재선택 모두 이 필드 하나로 표현(select()가 덮어씀)']

  indexes {
    (member_id) [unique, name: 'uk_member_librarian_selection_member_id', note: '회원당 대표 사서 1개']
  }

  Note: '회원이 선택한 대표 동물 사서. aggregate root.'
}
